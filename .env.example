# Образец настроек. Скопируйте: cp .env.example .env — и задайте свои значения.
# Файл .env в Git не попадает (см. .gitignore): реальный пароль храните только в нём.

# Порт на компьютере, на котором открывается приложение
APP_PORT=8090
# Заголовок страницы и метка окружения
APP_TITLE=Генератор случайных чисел
APP_ENV=compose
# Диапазон по умолчанию и длина истории
DEFAULT_MIN=1
DEFAULT_MAX=100
HISTORY_LIMIT=10
# База данных PostgreSQL (контейнер db)
POSTGRES_DB=rng
POSTGRES_USER=rng
POSTGRES_PASSWORD=change-me
