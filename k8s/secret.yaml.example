# Образец Secret. Рабочий k8s/secret.yaml создаётся локально и в Git не попадает:
#   cp k8s/secret.yaml.example k8s/secret.yaml   — и задать свой пароль
# (kubectl apply -f k8s/ читает только *.yaml/*.yml/*.json, поэтому сам образец не применяется)
apiVersion: v1
kind: Secret
metadata:
  name: rng-secret
  namespace: rng
type: Opaque
stringData:
  DB_PASSWORD: "change-me"
